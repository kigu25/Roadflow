@startchen E/R Diagram for RoadFlow Database
top to bottom direction


entity Camera {
    camera_id <<key>>
    trafikverket_id
    camera_name
    latitude
    longitude
}

entity data_gap{
    data_gap_id <<key>>
    camera_id
    gap_start
    gap_end
    reason
}

entity photo{
    photo_id <<key>>
    camera_id
    photo_time
    original_filepath
}

entity analysis{
    analysis_id<<key>>
    photo_id
    nr_detected_vehicle
    analyzed_filepath
}

entity detection{
    detection_id<<key>>
    analysis_id
    vehicle_class
    detection_confidence
    bounding_x1
    bounding_y1
    bounding_x2
    bounding_y2
}


relationship takes{
}

relationship produces{
}

relationship contains {

}


Camera -1- takes
takes -M- photo
photo -1- produces
produces -01- analysis
analysis -1- contains
contains -M- detection



@endchen